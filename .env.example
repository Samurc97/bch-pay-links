# Copy to .env and fill in. NEVER commit a real .env or seed phrase.
PORT=3000

# chipnet (dev/testnet) | mainnet (production demo)
BCH_NETWORK=chipnet

# BIP39 mnemonic for the merchant HD wallet. Each payment link derives a
# fresh address at the next deposit index. Generate a NEW one for mainnet:
#   node -e "import('mainnet-js').then(m => m.TestNetHDWallet.newRandom().then(w => console.log(w.getSeed())))"
MERCHANT_SEED=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about

# Electrum (Fulcrum/ElectrumX) server for payment detection.
# chipnet default works out of the box; override for mainnet.
#ELECTRUM_HOST=chipnet.bch.ninja
#ELECTRUM_PORT=50002

# Background poller interval and default link lifetime.
POLL_INTERVAL_MS=20000
LINK_TTL_MINUTES=60

# Set to "true" to run with an in-memory fake chain (tests, offline demos).
USE_MOCK_CHAIN=false

# Where links.json and merchants.json are persisted.
DATA_DIR=./data

# WizardConnect pairing: "true" (default) opens a live relay session and the
# POST /merchants QR is a real WIZ:// URI for the wallet to scan.
# "false" disables the relay (tests, offline): pairing completes by POSTing
# the xpub to /merchants/:id/pair.
WIZARDCONNECT_RELAY=true
